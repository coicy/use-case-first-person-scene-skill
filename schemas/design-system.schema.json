{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucscene/v0.7/design-system.schema.json",
  "title": "User-approved product-wide DesignSystem v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "product_id",
    "source_brief_sha256",
    "source_plan_sha256",
    "selected_variant_id",
    "revision",
    "locked",
    "approved_design",
    "approved_decisions",
    "hard_constraints",
    "approval",
    "history",
    "digest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "design-system"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "source_brief_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selected_variant_id": {
      "type": "string",
      "pattern": "^VAR-[0-9]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "locked": {
      "type": "boolean"
    },
    "approved_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "navigation",
        "visual_style",
        "controls",
        "information_priority",
        "feedback",
        "label",
        "tradeoff"
      ],
      "properties": {
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "navigation": {
          "type": "string",
          "minLength": 1
        },
        "visual_style": {
          "type": "string",
          "minLength": 1
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "information_priority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approved_decisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://example.invalid/ucscene/v0.7/design-decision.schema.json",
        "title": "DesignDecision v1 — unapproved proposals by default",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "id",
          "product_id",
          "topic",
          "proposal",
          "rationale",
          "status",
          "locked",
          "revision",
          "source",
          "related_use_case_ids",
          "effects"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "approved"
          },
          "locked": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "enum": [
              "ai-proposal",
              "user-proposal",
              "user-decision"
            ]
          },
          "related_use_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "evidence_ref"
            ],
            "properties": {
              "by": {
                "const": "user"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "approved",
                    "rejected"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "approval"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "approval"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "locked": {
                  "const": true
                }
              },
              "required": [
                "locked"
              ]
            },
            "then": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              }
            }
          }
        ]
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "value",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "source": {
            "enum": [
              "user-confirmed",
              "user-prompt"
            ]
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "evidence_ref"
      ],
      "properties": {
        "by": {
          "const": "user"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "action",
          "changed_keys",
          "evidence_ref",
          "previous_sha256"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "enum": [
              "approve",
              "revise",
              "revise-locked"
            ]
          },
          "changed_keys": {
            "type": "array",
            "items": {
              "enum": [
                "ui.layout",
                "ui.navigation",
                "ui.visual_style"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "previous_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
