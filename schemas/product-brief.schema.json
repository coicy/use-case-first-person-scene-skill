{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucscene/v0.7/product-brief.schema.json",
  "title": "ProductBrief v1 — new-product concept intent, not a screenshot contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "name",
    "category",
    "concept",
    "requirements",
    "hard_constraints",
    "use_cases",
    "unknowns",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "desktop",
        "web",
        "mobile",
        "game",
        "other"
      ]
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source",
          "authority",
          "use_case_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "user-prompt",
              "user-confirmed",
              "legacy-case"
            ]
          },
          "authority": {
            "enum": [
              "source-stated",
              "review-required"
            ]
          },
          "use_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "value",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "source": {
            "enum": [
              "user-prompt",
              "user-confirmed"
            ]
          }
        }
      }
    },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "actor",
          "goal",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "action",
                "state",
                "visible_evidence",
                "flow",
                "ui_text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "enum": [
                    "start",
                    "in-progress",
                    "waiting",
                    "success",
                    "failure"
                  ]
                },
                "visible_evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "flow": {
                  "enum": [
                    "main",
                    "alternative",
                    "exception"
                  ]
                },
                "ui_text": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_id"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct-prompt",
            "legacy-migration",
            "curated"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
