{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucscene/use-case.schema.json",
  "title": "Software-only in-application scene use case",
  "type": "object",
  "required": [
    "id",
    "title",
    "actor",
    "goal",
    "environment",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "description": "Context INSIDE the application, such as a scene, level, document, or workspace; not a physical desk or external room."
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "description": "Deprecated source metadata only. Never render external physical devices."
    },
    "style": {
      "enum": [
        "realistic",
        "sketch",
        "illustration",
        "ui-focused"
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "continuity": {
          "type": "string"
        },
        "must_show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "visible_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "start",
              "in-progress",
              "waiting",
              "success",
              "failure"
            ]
          },
          "branch": {
            "enum": [
              "main",
              "alternative",
              "exception"
            ]
          },
          "visible_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ui_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "viewpoint_mode": {
      "type": "string",
      "enum": [
        "application-ui",
        "gameplay"
      ]
    },
    "frame_scope": {
      "const": "software-only",
      "description": "Output is exclusively software/game pixels with no users or external devices"
    },
    "game_camera": {
      "enum": [
        "documented",
        "first-person",
        "isometric",
        "top-down",
        "side-scrolling",
        "third-person"
      ]
    }
  }
}
